# Stage 1: Build & Dependencies
FROM python:3.12-slim as builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runtime Image
FROM python:3.12-slim as runner

WORKDIR /app

RUN groupadd -g 1001 agreemate && \
    useradd -u 1001 -g agreemate -s /bin/bash -m agreemate

COPY --from=builder /root/.local /home/agreemate/.local
ENV PATH=/home/agreemate/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1

COPY backend/ /app/backend/

RUN chown -R agreemate:agreemate /app

USER agreemate

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
