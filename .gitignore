# ==============================================================================
# AgreeMate — Comprehensive Git Ignore Policy
# Covers: FastAPI backend, Next.js 16 frontend, Python, Node, OS, IDEs & Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (NEVER commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
# ------------------------------------------------------------------------------
# 2. Node & Next.js Frontend
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js build and Turbopack dev caches
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/
.turbo/
*/.turbo/
.vercel/

# TypeScript compiler artifacts
*.tsbuildinfo
*/tsconfig.tsbuildinfo
next-env.d.ts

# Package managers lock/cache
.pnp/
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 3. Python Backend & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
.venv/
venv/
ENV/
env/
*/venv/
*/.venv/

# Python packaging & distribution
develop-eggs/
eggs/
*.egg-info/
*.egg
parts/
var/
sdist/
wheels/
share/python-wheels/

# ------------------------------------------------------------------------------
# 4. Testing, Coverage & Linters
# ------------------------------------------------------------------------------
.pytest_cache/
*/.pytest_cache/
.ruff_cache/
*/.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
*.cover
htmlcov/
coverage/
*/coverage/
.hypothesis/
test-results/
playwright-report/
blob-report/

# ------------------------------------------------------------------------------
# 5. Local Artifacts, AI Agents & Scratch
# ------------------------------------------------------------------------------
.agents/explorer_*
.agents/orchestrator/
.agents/sentinel/
scratch/
*/scratch/
graphify-out/
.system_generated/
*.tmp
*.bak
*.swp
*.swo

# Generated exports and reports (preserve source assets in public/)
*.pdf
*.zip
!public/**
!frontend/public/**

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# ------------------------------------------------------------------------------
# 7. IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-project
*.sublime-workspace
.fleet/

# Database dumps & local backups
dump/
backups/
*.dump
*.sql
*.sqlite3
*.db

# Local agent notes and generated analysis
.agents/
.codex/
.planning/
docs/plans/
docs/superpowers/
*.log
*.temp
*.cache
.nyc_output/
.cache/
