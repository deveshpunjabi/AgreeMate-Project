# ==========================================
# AgreeMate Environment Variables Template (.env.example)
# Copy this file to .env and configure your values.
# ==========================================

# 1. MongoDB Database
MONGODB_URL=mongodb://localhost:27017

# 2. JWT Cryptographic Security
# Required: generate a random secret of at least 32 characters before starting.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 3. Email Dispatch Service (Gmail SMTP via aiosmtplib)
# For cloud deployments (Render), Port 465 (Direct SSL) is recommended to avoid STARTTLS blocks.
# Ensure you generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# 4. Storage Integration (Cloudinary CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 5. Application Routing & Endpoints
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
ENVIRONMENT=development
DATABASE_NAME=agreemate
CRON_SECRET=
ENABLE_IN_PROCESS_SCHEDULER=false
